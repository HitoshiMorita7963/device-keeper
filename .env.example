# PostgreSQL 接続文字列 (必須)
# 開発: npm run db:start で起動するローカル DB の既定値
DATABASE_URL="postgresql://device_keeper:device_keeper_dev@localhost:5433/device_keeper?schema=public"

# テスト用 DB (npm test で使用。テスト実行時に全データが削除されるため本番 DB を指定しないこと)
TEST_DATABASE_URL="postgresql://device_keeper:device_keeper_dev@localhost:5433/device_keeper_test?schema=public"

# 初期管理者 (npm run db:seed で作成。パスワードは12文字以上)
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# セッション有効期間 (時間)。既定 12
# SESSION_TTL_HOURS=12

# HTTPS 終端より後ろで動かす場合でも Cookie に Secure 属性を付ける (本番は既定で true)
# SESSION_COOKIE_SECURE=true
