// 社内IT資産管理システム (device-keeper) データベース定義
// テーブル名・カラム名は設計書 (docs/database.md) に合わせ snake_case にマッピングしている。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 列挙型
// ---------------------------------------------------------------------------

/// システム利用者の権限
enum Role {
  ADMIN // 管理者
  ASSET_MANAGER // IT資産管理担当者
  EMPLOYEE // 一般社員
}

/// 在籍状態
enum EmploymentStatus {
  ACTIVE // 在籍
  ON_LEAVE // 休職
  RETIRED // 退職
}

/// 端末状態
enum DeviceStatus {
  IN_STOCK // 保管中
  IN_USE // 使用中
  REPAIR // 修理中
  LOST // 紛失
  DISPOSED // 廃棄済み
}

/// 修理・故障対応状況
enum MaintenanceStatus {
  REPORTED // 受付
  IN_PROGRESS // 修理中
  COMPLETED // 完了
  CANCELLED // 取消
}

// ---------------------------------------------------------------------------
// マスタ
// ---------------------------------------------------------------------------

/// 部署マスタ
model Department {
  id             Int      @id @default(autoincrement())
  departmentCode String   @unique @map("department_code")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

/// 拠点マスタ
model Location {
  id           Int      @id @default(autoincrement())
  locationCode String   @unique @map("location_code")
  name         String
  address      String?
  managerName  String?  @map("manager_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employees Employee[]
  devices   Device[]
  movesFrom DeviceLocationHistory[] @relation("MoveFrom")
  movesTo   DeviceLocationHistory[] @relation("MoveTo")

  @@map("locations")
}

/// 社員情報
model Employee {
  id               Int              @id @default(autoincrement())
  employeeNumber   String           @unique @map("employee_number")
  name             String
  email            String?          @unique
  departmentId     Int?             @map("department_id")
  homeLocationId   Int?             @map("home_location_id")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  joinedAt         DateTime?        @map("joined_at") @db.Date
  retiredAt        DateTime?        @map("retired_at") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  homeLocation Location?          @relation(fields: [homeLocationId], references: [id], onDelete: Restrict)
  assignments  DeviceAssignment[]
  devices      Device[]           @relation("CurrentUser")
  user         User?

  @@index([departmentId])
  @@index([homeLocationId])
  @@map("employees")
}

/// 資産種別マスタ。prefix は資産管理番号の自動採番に使う (例: PC → PC-000001)
model DeviceCategory {
  id           Int      @id @default(autoincrement())
  categoryCode String   @unique @map("category_code")
  name         String
  prefix       String   @unique
  /// 自動採番の数値部の桁数
  numberDigits Int      @default(6) @map("number_digits")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  devices  Device[]
  sequence AssetNumberSequence?

  @@map("device_categories")
}

/// 資産管理番号の採番カウンタ (資産種別ごと)。行ロックで同時採番の重複を防ぐ
model AssetNumberSequence {
  categoryId Int      @id @map("category_id")
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("asset_number_sequences")
}

// ---------------------------------------------------------------------------
// 端末台帳と履歴
// ---------------------------------------------------------------------------

/// 端末台帳。deleted_at による論理削除のみ行う
model Device {
  id                        Int          @id @default(autoincrement())
  assetNumber               String       @unique @map("asset_number")
  name                      String
  categoryId                Int          @map("category_id")
  manufacturer              String?
  model                     String?
  serialNumber              String?      @map("serial_number")
  osName                    String?      @map("os_name")
  osVersion                 String?      @map("os_version")
  purchaseDate              DateTime?    @map("purchase_date") @db.Date
  purchasePrice             Int?         @map("purchase_price")
  purchaseVendor            String?      @map("purchase_vendor")
  warrantyExpiry            DateTime?    @map("warranty_expiry") @db.Date
  currentLocationId         Int          @map("current_location_id")
  /// 現在の利用者 (貸出中のみ設定)。正は device_assignments の未返却レコード
  currentEmployeeId         Int?         @map("current_employee_id")
  status                    DeviceStatus @default(IN_STOCK)
  notes                     String?
  hostname                  String?
  /// 用途 (営業用・開発用など)
  purpose                   String?
  cpu                       String?
  memory                    String?
  disk                      String?
  /// 自宅への持ち帰り (在宅勤務用の貸出) を開始した日
  homeLoanedAt              DateTime?    @map("home_loaned_at") @db.Date
  /// リカバリ (初期化) の実施状況などのメモ
  recovery                  String?
  /// 端末の初期ユーザー名 / 利用者用ユーザー名
  initialUser               String?      @map("initial_user")
  loginUser                 String?      @map("login_user")
  /// 端末のパスワード。AES-256-GCM で暗号化して保存する (src/lib/crypto/secret.ts)。管理者のみ復号して表示できる
  initialPasswordEnc        String?      @map("initial_password_enc")
  loginPasswordEnc          String?      @map("login_password_enc")
  /// Windows のコンピューター名 (COMPUTERNAME)。端末の取得スクリプトが送信し、管理画面からは変更しない
  computerName              String?      @map("computer_name")
  computerNameUpdatedAt     DateTime?    @map("computer_name_updated_at")
  /// 管理者が自由に付ける管理用の端末名 (PC 名とは独立)
  managementName            String?      @map("management_name")
  managementNameUpdatedAt   DateTime?    @map("management_name_updated_at")
  managementNameUpdatedById Int?         @map("management_name_updated_by")
  /// 端末連携キー (PC 名の送信用) の SHA-256。キー本体は保存しない
  agentTokenHash            String?      @unique @map("agent_token_hash")
  agentTokenIssuedAt        DateTime?    @map("agent_token_issued_at")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")
  deletedAt                 DateTime?    @map("deleted_at")

  category                DeviceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentLocation         Location                @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  currentEmployee         Employee?               @relation("CurrentUser", fields: [currentEmployeeId], references: [id], onDelete: Restrict)
  assignments             DeviceAssignment[]
  locationHistory         DeviceLocationHistory[]
  maintenance             MaintenanceRecord[]
  disposal                DisposalRecord?
  managementNameUpdatedBy User?                   @relation("ManagementNameUpdatedBy", fields: [managementNameUpdatedById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([currentLocationId])
  @@index([currentEmployeeId])
  @@index([status])
  @@index([warrantyExpiry])
  @@index([serialNumber])
  @@index([hostname])
  @@map("devices")
}

/// 貸与履歴
model DeviceAssignment {
  id                 Int       @id @default(autoincrement())
  deviceId           Int       @map("device_id")
  employeeId         Int       @map("employee_id")
  assignedAt         DateTime  @map("assigned_at") @db.Date
  expectedReturnAt   DateTime? @map("expected_return_at") @db.Date
  returnedAt         DateTime? @map("returned_at") @db.Date
  assignedById       Int?      @map("assigned_by")
  returnedById       Int?      @map("returned_by")
  conditionOnReturn  String?   @map("condition_on_return")
  /// 返却時の付属品確認結果
  accessoriesChecked Boolean?  @map("accessories_checked")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  returnedBy User?    @relation("ReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  // 同一端末に未返却の貸与を複数作らない (データ整合性ルール5)
  @@unique([deviceId], map: "device_assignments_one_open_per_device", where: raw("returned_at IS NULL"))
  @@index([deviceId])
  @@index([employeeId])
  @@index([expectedReturnAt])
  @@map("device_assignments")
}

/// 拠点移動履歴
model DeviceLocationHistory {
  id             Int      @id @default(autoincrement())
  deviceId       Int      @map("device_id")
  fromLocationId Int?     @map("from_location_id")
  toLocationId   Int      @map("to_location_id")
  movedAt        DateTime @map("moved_at") @db.Date
  movedById      Int?     @map("moved_by")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("MoveFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location  @relation("MoveTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  movedBy      User?     @relation("MovedBy", fields: [movedById], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@map("device_location_history")
}

/// 修理・故障履歴
model MaintenanceRecord {
  id                   Int               @id @default(autoincrement())
  deviceId             Int               @map("device_id")
  reportedAt           DateTime          @map("reported_at") @db.Date
  problemDescription   String            @map("problem_description")
  repairVendor         String?           @map("repair_vendor")
  repairCost           Int?              @map("repair_cost")
  repairedAt           DateTime?         @map("repaired_at") @db.Date
  status               MaintenanceStatus @default(REPORTED)
  /// 修理受付前の端末状態 (完了時に戻す先)
  previousDeviceStatus DeviceStatus?     @map("previous_device_status")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  // 同一端末に対応中 (受付・修理中) の修理を複数作らない
  @@unique([deviceId], map: "maintenance_records_one_open_per_device", where: raw("status IN ('REPORTED', 'IN_PROGRESS')"))
  @@index([deviceId])
  @@index([status])
  @@map("maintenance_records")
}

/// 廃棄履歴 (端末1台につき1件)
model DisposalRecord {
  id                   Int      @id @default(autoincrement())
  deviceId             Int      @unique @map("device_id")
  disposedAt           DateTime @map("disposed_at") @db.Date
  disposalReason       String   @map("disposal_reason")
  disposalMethod       String?  @map("disposal_method")
  disposalVendor       String?  @map("disposal_vendor")
  dataErasureConfirmed Boolean  @default(false) @map("data_erasure_confirmed")
  disposedById         Int?     @map("disposed_by")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")

  device     Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  disposedBy User?  @relation("DisposedBy", fields: [disposedById], references: [id], onDelete: SetNull)

  @@map("disposal_records")
}

// ---------------------------------------------------------------------------
// 認証・監査
// ---------------------------------------------------------------------------

/// システム利用者
model User {
  id               Int       @id @default(autoincrement())
  employeeId       Int?      @unique @map("employee_id")
  email            String    @unique
  displayName      String    @map("display_name")
  passwordHash     String?   @map("password_hash")
  /// 外部認証 (Microsoft Entra ID 等) 導入時の利用者ID
  externalAuthId   String?   @unique @map("external_auth_id")
  role             Role      @default(EMPLOYEE)
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee               Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions               Session[]
  auditLogs              AuditLog[]
  assignmentsMade        DeviceAssignment[]      @relation("AssignedBy")
  assignmentsClosed      DeviceAssignment[]      @relation("ReturnedBy")
  moves                  DeviceLocationHistory[] @relation("MovedBy")
  disposals              DisposalRecord[]        @relation("DisposedBy")
  managementNamesUpdated Device[]                @relation("ManagementNameUpdatedBy")

  @@map("users")
}

/// ログインセッション。Cookie にはランダムトークンのみを保存し、DB には SHA-256 ハッシュを保持する
model Session {
  id        String   @id // トークンの SHA-256 ハッシュ (hex)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// 操作履歴 (監査ログ)。追記のみで更新・削除しない
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
